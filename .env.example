# ============ 晴屿 · 智能天气 配置示例 ============
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- 位置 ----------
# 城市名（中文/英文均可，用于地理编码）
CITY=北京
# 或者直接指定经纬度（优先于城市名）
# LATITUDE=39.9042
# LONGITUDE=116.4074
# 展示用城市名（可选，默认同 CITY）
# DISPLAY_CITY=北京

# ---------- 时区 ----------
# IANA 时区（如 Asia/Shanghai、Europe/London）
TIMEZONE=Asia/Shanghai

# ---------- 可选：和风天气官方预警（QWeather） ----------
# 不配置则仅使用内置规则引擎（免费，无需 Key）
# QWEATHER_API_KEY=你的和风天气Key

# ---------- 可选：Open-Meteo 预报模型 ----------
# 中国地区可填 cma_grapes_global（中国气象局模式，更贴近官方；无紫外线指数）
# OPEN_METEO_MODELS=cma_grapes_global

# ---------- 在线灾害预警 / 台风路径（中央气象台，免费无需 Key，一般无需修改） ----------
# NMC_ALARM_URL=http://www.nmc.cn/rest/findAlarm
# TYPHOON_LIST_URL=http://typhoon.nmc.cn/weatherservice/typhoon/jsons/list_default
# TYPHOON_VIEW_URL=http://typhoon.nmc.cn/weatherservice/typhoon/jsons/view_{sid}
# TYPHOON_MAX_RANGE_KM=700

# ---------- 预警阈值（默认值已合理，一般无需修改） ----------
# WARN_WIND_SPEED=17.2
# WARN_WIND_STRONG=24.5
# WARN_WIND_TYPHOON=32.7
# WARN_WIND_GUST=32.7
# WARN_TEMP_HIGH=40
# WARN_TEMP_LOW=-10
# WARN_PRECIP_HOURLY=10
# WARN_VISIBILITY=1000
# WARN_UV_INDEX=8

LOG_LEVEL=INFO

